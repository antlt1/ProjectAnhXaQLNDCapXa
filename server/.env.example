# ===== Kết nối SQL Server =====
# Tên máy chủ / instance. Ví dụ: localhost, .\\SQLEXPRESS, 192.168.1.10
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=NHONAI
DB_INSTANCE=

# Xác thực SQL Server (bỏ trống nếu dùng Windows Authentication)
DB_USER=sa
DB_PASSWORD=doi_mat_khau

# Windows Authentication: bật true (cần cài msnodesqlv8)
DB_TRUSTED=false

# Mã hoá kết nối
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# ===== API =====
PORT=3001
# DEMO_MODE=true: chạy bằng dữ liệu mẫu, không kết nối SQL Server
DEMO_MODE=false
NODE_ENV=development

# ===== Rà soát chèn CCCD từ Excel =====
# Đường dẫn file Excel (tương đối từ thư mục gốc dự án hoặc tuyệt đối)
RECONCILE_FILE=Xã Nhơn Ái DS.xlsx
# Tên sheet (bỏ trống = sheet đầu tiên)
RECONCILE_SHEET=
# Region_ID của xã cần đối chiếu (mặc định: Xã Nhơn Ái)
RECONCILE_REGION_ID=9203831315
# Thư mục lưu xác nhận JSON
RECONCILE_DATA_DIR=server/data
# Cache dữ liệu nhân khẩu tải từ SQL Server (ms)
RECONCILE_DB_CACHE_MS=300000
